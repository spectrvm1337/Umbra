{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri/refs/heads/dev/crates/tauri-config-schema/schema.json",
  "productName": "Umbra",
  "version": "0.1.2",
  "identifier": "com.umbra.search",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Umbra",
        "url": "index.html",
        "width": 660,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      },
      {
        "label": "chat",
        "title": "Umbra Chat",
        "url": "chat.html",
        "width": 400,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: file:; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost https://wttr.in https://api.frankfurter.app; media-src 'self' data:"
    }
  }
}
