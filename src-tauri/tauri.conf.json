{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra",
  "version": "0.2.3",
  "identifier": "com.umbra.search",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Umbra",
        "url": "index.html",
        "width": 660,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; img-src 'self' data: file: http://asset.localhost; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost https://cdn.jsdelivr.net https://*.currency-api.pages.dev; media-src 'self' data: blob: http://asset.localhost; frame-src http://asset.localhost",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.mp4", "**/*.m4v", "**/*.webm", "**/*.mkv", "**/*.avi",
          "**/*.mov", "**/*.wmv", "**/*.flv", "**/*.3gp", "**/*.mpeg",
          "**/*.mpg", "**/*.ogv", "**/*.mp3", "**/*.m4a", "**/*.aac", "**/*.wav",
          "**/*.ogg", "**/*.oga", "**/*.opus", "**/*.flac", "**/*.wma", "**/*.mid", "**/*.gif", "**/*.webp", "**/*.apng", "**/*.pdf"
        ]
      }
    }
  }
}
